#!/bin/sh

MPIRUN="${TRAMPI_ABI_LIBRARY_MPIRUN:-@DEFAULT_MPIRUN@}"

if [ -z "$MPIRUN" ]; then
    echo "TRAMPI:: No MPI launcher configured." >&2
    echo "TRAMPI:: Please set TRAMPI_ABI_LIBRARY_MPIRUN or configure a default." >&2
    exit 1
fi

# Verify the launcher exists
if ! command -v "$MPIRUN" >/dev/null 2>&1; then
  echo "TRAMPI:: Launcher not found: $MPIRUN" >&2
  exit 1
fi
exec -a "$0" "$MPIRUN" "$@"
