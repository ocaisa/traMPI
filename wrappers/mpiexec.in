#!/bin/sh

MPIEXEC="${TRAMPI_ABI_LIBRARY_MPIEXEC:-@DEFAULT_MPIEXEC@}"

if [ -z "$MPIEXEC" ]; then
    echo "TRAMPI:: No MPI launcher configured." >&2
    echo "TRAMPI:: Please set TRAMPI_ABI_LIBRARY_MPIEXEC or configure a default." >&2
    exit 1
fi

# Verify the launcher exists
if ! command -v "$MPIEXEC" >/dev/null 2>&1; then
  echo "TRAMPI:: Launcher not found: $MPIEXEC" >&2
  exit 1
fi
exec -a "$0" "$MPIEXEC" "$@"
