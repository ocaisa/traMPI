name = 'MPICH'
version = '5.0.2'
versionsuffix = "-dev-mpif"

homepage = 'https://www.mpich.org/'
description = """MPICH is a high-performance and widely portable implementation
of the Message Passing Interface (MPI) standard (MPI-1, MPI-2 and MPI-3)."""

toolchain = {'name': 'GCC', 'version': '15.2.0'}
toolchainopts = {
    'extra_fflags': '-w -fallow-argument-mismatch'
}

source_urls = ['https://www.mpich.org/static/downloads/%(version)s']
local_commit_for_mpif = "ab53493dad85ffee0fc95812b250e1c8dacf7982"
sources = {
    'filename': f'{local_commit_for_mpif}.tar.xz',
    "git_config": {
        "url": "https://github.com/pmodels",
        "repo_name": "mpich",
        "commit": f"{local_commit_for_mpif}",
        "recursive": True,
        },
},
patches = ["mpich_mpif.patch"]

preconfigopts = "./autogen.sh && "

dependencies = [
    ('hwloc', '2.13.0'),
    ('UCX', '1.20.0'),
]

# Also build (separate) MPI ABI
mpi_abi = True

moduleclass = 'mpi'
