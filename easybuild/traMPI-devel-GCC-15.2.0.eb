easyblock = 'Bundle'

name = 'traMPI'
version = '0.1.0-devel'
versionsuffix = '-%(software_commit)s'

homepage = 'https://github.com/ocaisa/traMPI'
description = """
A trampoline generator for the MPI 5.0 ABI which generates an MPI 5.0 ABI
library that can be overridden by the environment variable TRAMPI_ABI_LIBRARY.
"""

toolchain = {'name': 'GCC', 'version': '15.2.0'}

builddependencies = [
    ('CMake', '4.2.1'),
    ('Python', '3.14.2'),
    # Allows us to provide a default MPI backend (requires that MPICH was built with RPATH)
    ('MPICH', '5.0.2', '-dev-mpif'),
]

default_easyblock = 'CMakeMake'
default_component_specs = {
    'source_urls': ['https://github.com/ocaisa/traMPI/archive'],
    'sources': [{
        'filename': '%(software_commit)s.tar.xz',
        "git_config": {
            "url": "https://github.com/ocaisa",
            "repo_name": "traMPI",
            "commit": "%(software_commit)s",
            "recursive": True,
            },
    }],
}

components = [
    (name, version, {
        'start_dir': 'traMPI',
        # The trampoline is generated during the build (see CMakeLists.txt); the
        # defaults below may be overridden at run time with TRAMPI_ABI_LIBRARY,
        # TRAMPI_ABI_LIBRARY_MPIRUN and TRAMPI_ABI_LIBRARY_MPIEXEC
        # (assumes the launcher defaults are RPATH-ed executables which is true for MPICH and OpenMPI)
        'configopts': " ".join([
            '-DTRAMPI_DEFAULT_ABI_LIBRARY="$EBROOTMPICH/lib/libmpi_abi.so"',
            '-DTRAMPI_DEFAULT_MPIRUN="$EBROOTMPICH/bin/mpirun"',
            '-DTRAMPI_DEFAULT_MPIEXEC="$EBROOTMPICH/bin/mpiexec"',
        ]),
    }),
    ('mpif', '1.0.0', {
        'start_dir': 'traMPI/mpif',
        'preconfigopts': " && ".join([
            # Force mpif to see our (just installed) traMPI library first
            # 'export LDFLAGS="-L%(installdir)s/lib"',
            # Tweak the MPI compiler wrapper to grab the default compiler from the PATH (and based on the toolchain)
            "sed -i 's|@CMAKE_Fortran_COMPILER@|${TRAMPI_FC:-'$FC'}|' ../traMPI/mpif/bin/mpifort.in",
            "",
        ]),
        # Use our just installed MPI compiler as the C compiler
        'configopts': '-DMPI_HOME="%(installdir)s" -DMPI_C_COMPILER="%(installdir)s"/bin/mpicc_abi',
        # Make sure our custom mpi header is preferred during the build (not the one visible from MPICH build dep)
        'prebuildopts': 'export CPATH="%(installdir)s/include:${CPATH}" &&',
    }),
]

sanity_check_paths = {
    'files': [
        'bin/mpicc',
        'bin/mpifort',
        'bin/mpiexec',
        'bin/mpirun',
        f'lib/libmpi_abi.{SHLIB_EXT}',
        'include/mpi.h',
    ],
    'dirs': [],
}

sanity_check_commands = [
    "mpicc -show",
    "mpifort -show",
    "mpirun --help",
    "mpiexec --help",
    # Sneak in the mpif tests (build them first)
    "module load CMake && cd %(start_dir)s/mpif/test && mkdir build && cd build && cmake .. && make -j ",
    # Run the mpif tests with the defaults (excluding one test that fails for some reason with that MPICH)
    "cd %(start_dir)s/mpif/test/build && LD_LIBRARY_PATH=$LIBRARY_PATH make test ARGS='-E status_error_f08'",
    # Now run with OpenMPI
    "cd %(start_dir)s/mpif/test/build && module load OpenMPI/6.0.0-GCC-15.2.0-dev-mpif && LD_LIBRARY_PATH=$LIBRARY_PATH TRAMPI_ABI_LIBRARY=$EBROOTOPENMPI/lib/libmpi_abi.so TRAMPI_FORCE_DLOPEN=1 TRAMPI_ABI_LIBRARY_MPIEXEC=$EBROOTOPENMPI/bin/mpiexec OMPI_MCA_btl=tcp,self OMPI_MCA_btl_tcp_if_include=eth0 OMPI_MCA_osc=^ucx make test"
]
